{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=<host>;Database=OptionsTrader;User Id=<user>;Password=<password>;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "<a long random secret, at least 32 characters>",
    "Issuer": "OptionsTraderAPI"
  },
  "AWS": {
    "AccessKey": "<aws access key id>",
    "SecretKey": "<aws secret access key>",
    "Region": "us-east-2",
    "BucketName": "options-trader-screenshots"
  }
}
